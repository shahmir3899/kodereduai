# Copy to `.env` before `docker compose up` (never commit `.env`).
# Full reference: https://github.com/devlikeapro/waha/blob/core/.env.example

WAHA_API_KEY=change-me-to-a-long-random-string-for-local-dev
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=change-me-dashboard-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=change-me-swagger-password

WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True

WHATSAPP_DEFAULT_ENGINE=WEBJS
WAHA_NAMESPACE=all
# Must match host port in docker-compose.yml (3080) for dashboard links and webhooks.
WAHA_BASE_URL=http://127.0.0.1:3080

WAHA_LOG_FORMAT=PRETTY
WAHA_LOG_LEVEL=info
WAHA_PRINT_QR=False

WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media
