# Copy to .env and fill in before running `docker compose up -d`.
# See README.md for where each value comes from.

# RTSP URL for a fixed IP camera, e.g. rtsp://user:pass@192.168.1.50:554/stream1
# — or a local device index (e.g. "0") for a USB webcam plugged into this
# machine (also needs the `devices:` mapping uncommented in docker-compose.yml).
CAMERA_SOURCE=rtsp://user:pass@192.168.1.50:554/stream1

# Base URL of the school's KoderEduAI backend (no trailing slash).
API_BASE_URL=https://kodereduai-api.onrender.com

# Raw device key, shown once in Django admin when the device row was
# created (Admin > Face Attendance > Face Capture Devices > Add).
DEVICE_KEY=

# Must exactly match the embedding_version set on this device's row in
# Django admin — the server rejects a mismatch. Tier B always uses the
# server's existing dlib_v1 space, so leave this unless told otherwise.
EMBEDDING_VERSION=dlib_v1

# Only process one sampled frame every N seconds — this is a periodic
# snapshot service, not continuous video processing.
SAMPLE_INTERVAL_SECONDS=3

# Faces smaller than this (width or height, in pixels) are skipped —
# mirrors the server's own MIN_FACE_SIZE quality gate.
MIN_FACE_SIZE=60

# Optional. Only meaningful if this device is CLASS-scoped in Django admin
# — sent as a consistency check, the server rejects a mismatch. Leave
# unset for a SCHOOL-scoped (e.g. entrance) device.
CLASS_ID=

# HTTP request timeout (seconds) when posting a match to the backend.
REQUEST_TIMEOUT_SECONDS=10

# Python logging level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
