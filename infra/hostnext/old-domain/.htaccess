# Old domain (kodereduai.pk) -> educationai.pk.
# Upload this file as-is, named exactly ".htaccess", into the document root of the OLD domain.
# Do not edit it in Notepad's Markdown/rich-text mode (it can strip the leading "#" from comments).
#
# Mapping (path and query string are kept):
#   kodereduai.pk, www.kodereduai.pk            -> https://www.educationai.pk/...
#   <school>.kodereduai.pk                      -> https://<school>.educationai.pk/...
#   educationai.com.pk, www.educationai.com.pk  -> https://www.educationai.pk/...
#   <school>.educationai.com.pk                 -> https://<school>.educationai.pk/...
#
# R=302 (temporary) while testing, because browsers cache a 301 hard and a mistake would stick.
# When every case checks out, change R=302 to R=301 in the 3 rules below.
# To undo: put the previous .htaccess back. Delete this when kodereduai.pk expires.

RewriteEngine On

# 1. Apex and www -> www on the new domain
RewriteCond %{HTTP_HOST} ^(www\.)?(kodereduai\.pk|educationai\.com\.pk)$ [NC]
RewriteRule ^ https://www.educationai.pk%{REQUEST_URI} [R=302,L,NE]

# 2. Any other subdomain (school, portal, demo, ...) -> same subdomain on the new domain
RewriteCond %{HTTP_HOST} ^([^.]+)\.kodereduai\.pk$ [NC]
RewriteRule ^ https://%1.educationai.pk%{REQUEST_URI} [R=302,L,NE]

RewriteCond %{HTTP_HOST} ^([^.]+)\.educationai\.com\.pk$ [NC]
RewriteRule ^ https://%1.educationai.pk%{REQUEST_URI} [R=302,L,NE]

# ---------------------------------------------------------------------------
# Everything below is the app's existing .htaccess, unchanged. It only applies to a host
# the redirects above did not match (should not normally happen on this folder), so
# nothing that worked before breaks.
# ---------------------------------------------------------------------------

# Force HTTPS in production hosting
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fresh app shell on every visit (closest safe equivalent to hard refresh)
<IfModule mod_headers.c>
	<FilesMatch "^(index\.html)$">
		Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		Header set Pragma "no-cache"
		Header set Expires "0"
	</FilesMatch>

	# Keep hashed static assets cacheable for performance.
	<FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	Header always set X-Frame-Options "DENY"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# SPA fallback: unknown paths go to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.html [L]
