RewriteEngine On

# Old brand domain: send kodereduai.pk (apex, www or a school subdomain) to the same host on educationai.pk.
# One shared folder serves both domains until kodereduai.pk expires, so this is keyed on the host.
RewriteCond %{HTTP_HOST} ^(?:www\.)?kodereduai\.pk$ [NC]
RewriteRule ^ https://educationai.pk%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^([^.]+)\.kodereduai\.pk$ [NC]
RewriteRule ^ https://%1.educationai.pk%{REQUEST_URI} [L,R=301]

# Force HTTPS in production hosting
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fresh app shell on every visit (closest safe equivalent to hard refresh)
# Note: true Ctrl+F5 cannot be forced server-side.
<IfModule mod_headers.c>
	<FilesMatch "^(index\.html)$">
		Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
		Header set Pragma "no-cache"
		Header set Expires "0"
	</FilesMatch>

	# Keep hashed static assets cacheable for performance.
	<FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
	Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	Header always set X-Frame-Options "DENY"
	Header always set X-Content-Type-Options "nosniff"
	Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# If the requested file or directory does not exist
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect all requests to index.html (SPA fallback)
RewriteRule ^ /index.html [L]
