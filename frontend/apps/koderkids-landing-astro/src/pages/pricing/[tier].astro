---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pricingDetails } from '../../content/pricingDetails';

export function getStaticPaths() {
  return Object.values(pricingDetails).map((plan) => ({
    params: { tier: plan.key },
    props: { plan },
  }));
}

const { plan } = Astro.props as {
  plan: (typeof pricingDetails)[keyof typeof pricingDetails];
};

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://www.koderkids.pk';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: `${plan.label} Pricing | Education AI`,
  url: `${siteUrl}/pricing/${plan.key}`,
  description: `${plan.label} plan details for Education AI including modules, capabilities, and exclusions.`,
};
---

<BaseLayout
  title={`${plan.label} Pricing | Education AI`}
  description={`${plan.summary} ${plan.bestFor}`}
  canonical={`/pricing/${plan.key}`}
  ogImage="/dashboard_overview.jpg"
  jsonLd={schema}
>
  <main id="main-content" class="py-20 bg-brand-light min-h-screen">
    <div class="max-w-5xl mx-auto px-6">
      <a href="/#pricing" class="text-sm text-primary hover:text-primary-600 transition-colors">← Back to pricing</a>

      <section class="mt-4 bg-white border border-gray-200 rounded-2xl p-8 sm:p-10 shadow-card">
        <span class="section-label mb-2 block">{plan.label} PLAN</span>
        <h1 class="font-display text-3xl sm:text-4xl font-bold text-brand-dark mb-3">{plan.label} Pricing Details</h1>
        <p class="text-brand-gray leading-relaxed mb-6">{plan.summary}</p>
        <div class="grid sm:grid-cols-2 gap-4">
          <div class="rounded-xl border border-gray-200 p-4">
            <p class="text-xs text-gray-500 mb-1">Monthly</p>
            <p class="font-semibold text-brand-dark">{plan.monthlyPrice}</p>
          </div>
          <div class="rounded-xl border border-gray-200 p-4">
            <p class="text-xs text-gray-500 mb-1">Annual</p>
            <p class="font-semibold text-brand-dark">{plan.annualPrice}</p>
          </div>
        </div>
        <p class="mt-5 text-sm text-brand-gray"><span class="font-semibold text-brand-dark">Best for:</span> {plan.bestFor}</p>
      </section>

      <section class="mt-6 grid lg:grid-cols-2 gap-6">
        <article class="bg-white border border-gray-200 rounded-2xl p-6 shadow-card">
          <h2 class="font-display text-xl font-bold text-brand-dark mb-4">Included modules</h2>
          <ul class="space-y-2">
            {plan.modules.map((item) => <li class="text-sm text-brand-gray">• {item}</li>)}
          </ul>
        </article>

        <article class="bg-white border border-gray-200 rounded-2xl p-6 shadow-card">
          <h2 class="font-display text-xl font-bold text-brand-dark mb-4">Unlocked capabilities</h2>
          <ul class="space-y-2">
            {plan.capabilities.map((item) => <li class="text-sm text-brand-gray">• {item}</li>)}
          </ul>
        </article>
      </section>

      <section class="mt-6 grid lg:grid-cols-2 gap-6">
        <article class="bg-white border border-gray-200 rounded-2xl p-6 shadow-card">
          <h2 class="font-display text-xl font-bold text-brand-dark mb-4">Not included</h2>
          <ul class="space-y-2">
            {plan.notIncluded.map((item) => <li class="text-sm text-brand-gray">• {item}</li>)}
          </ul>
        </article>
        <article class="bg-white border border-gray-200 rounded-2xl p-6 shadow-card">
          <h2 class="font-display text-xl font-bold text-brand-dark mb-4">Costly features policy</h2>
          <ul class="space-y-2">
            {plan.expensiveFeatures.map((item) => <li class="text-sm text-brand-gray">• {item}</li>)}
          </ul>
        </article>
      </section>

      <section class="mt-6 bg-brand-dark rounded-2xl p-6 sm:p-8">
        <h2 class="font-display text-xl font-bold text-white mb-2">Need help choosing?</h2>
        <p class="text-sm text-brand-gray">
          Share your school size, branches, and priority workflows. We will recommend the right plan.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <button
            type="button"
            onclick="document.dispatchEvent(new CustomEvent('open-demo-dialog'))"
            class="btn-primary"
          >
            Discuss {plan.label} Plan
          </button>
          <a href="/#pricing" class="btn-secondary">Compare all plans</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
