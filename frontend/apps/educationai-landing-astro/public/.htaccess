Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# ── 1. Old domains -> new domain (before HTTPS-force so it is a single hop) ─────
# kodereduai.pk and educationai.com.pk (apex and www) -> https://www.educationai.pk
# R=302 while testing (browsers cache 301 hard); change to R=301 once verified.
# Remove the kodereduai.pk part when that domain expires.
RewriteCond %{HTTP_HOST} ^(www\.)?(kodereduai\.pk|educationai\.com\.pk)$ [NC]
RewriteRule ^ https://www.educationai.pk%{REQUEST_URI} [R=302,L,NE]

# ── 2. Force HTTPS (handles both direct TLS and proxy/load-balancer setups) ──
RewriteCond %{HTTPS} !=on [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301,NE]

# ── 3. Redirect bare educationai.pk -> www ─────────────────────────────────
RewriteCond %{HTTP_HOST} ^educationai\.pk$ [NC]
RewriteRule ^ https://www.educationai.pk%{REQUEST_URI} [L,R=301,NE]

# Fresh HTML documents on each visit.
# Note: true Ctrl+F5 cannot be forced server-side.
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Keep static assets heavily cached for performance.
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── NOTE ────────────────────────────────────────────────────────────────────
# No SPA fallback here — Astro static output uses directory-based routing.
# Apache serves /privacy/ → /privacy/index.html automatically via DirectoryIndex.
# This file lives in public/ and is copied to dist/ on every `npm run build`.
# ────────────────────────────────────────────────────────────────────────────
