---
import { landingContent } from '../../content/landing';
import { pricingDetails } from '../../content/pricingDetails';
const { pricing } = landingContent;
const plan = pricingDetails.flat;
---

<section id="pricing" class="py-24 bg-brand-light">
  <div class="max-w-3xl mx-auto px-6">

    <!-- Header -->
    <div class="text-center mb-14">
      <span class="section-label mb-3 block">{pricing.label}</span>
      <h2 class="font-display text-3xl sm:text-4xl font-bold text-brand-dark mb-4">
        {pricing.heading}
      </h2>
      <p class="text-brand-gray text-lg max-w-xl mx-auto">{pricing.subheading}</p>
    </div>

    <!-- Single flat plan card -->
    <div class="relative flex flex-col rounded-2xl p-10 border bg-brand-dark border-primary/40 shadow-dashboard mx-auto max-w-xl">

      <!-- Badge -->
      <span class="absolute top-5 right-5 text-xs font-semibold px-3 py-1 rounded-full bg-primary/20 text-primary-300">
        All-Inclusive
      </span>

      <!-- Label -->
      <div class="text-sm font-bold uppercase tracking-wider mb-1 text-primary-300">
        {plan.label}
      </div>

      <!-- Summary -->
      <p class="text-sm leading-relaxed mb-6 text-brand-gray">{plan.summary}</p>

      <!-- Price -->
      <div class="mb-6">
        <p class="font-display text-3xl font-bold text-white">{plan.monthlyPrice}</p>
        <p class="text-xs mt-1 text-gray-300">{plan.annualPrice}</p>
      </div>

      <!-- Modules included -->
      <ul class="space-y-2 mb-8">
        {plan.modules.map((mod) => (
          <li class="flex items-start gap-2.5">
            <svg
              class="w-4 h-4 mt-0.5 flex-shrink-0 text-primary-300"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.5"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-sm text-gray-300">{mod}</span>
          </li>
        ))}
      </ul>

      <!-- CTA -->
      <a
        href="/contact"
        class="block w-full text-center text-sm font-semibold rounded-full py-3 px-6 transition-all hover:-translate-y-0.5 bg-primary text-white hover:bg-primary-600 hover:shadow-[0_6px_20px_rgba(43,106,255,0.4)]"
      >
        Get Started — Contact Us
      </a>
    </div>

    <p class="text-center text-sm text-brand-gray mt-8">
      One plan. All modules. No hidden tiers. Annual billing saves 10%.
    </p>
  </div>
</section>
