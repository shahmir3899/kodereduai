---
import SeoHead from '../components/seo/SeoHead.astro';
import LegalInfoDialog from '../components/islands/LegalInfoDialog.tsx';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  robots?: string;
  ogImage?: string;
  ogType?: string;
  jsonLd?: object | object[];
  lang?: string;
  alternates?: { lang: string; href: string }[];
}

const { title, description, canonical, robots, ogImage, ogType, jsonLd, lang = 'en', alternates } = Astro.props as Props;
const isUrdu = lang === 'ur';

// Inner pages get a breadcrumb trail (Home > page) so search results can show the page path.
const siteBase = (Astro.site?.toString() ?? 'https://www.educationai.pk').replace(/\/$/, '');
const breadcrumb = canonical && canonical !== '/' && !isUrdu
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteBase}/` },
        { '@type': 'ListItem', position: 2, name: title.split(' | ')[0], item: `${siteBase}${canonical.endsWith('/') ? canonical : `${canonical}/`}` },
      ],
    }
  : null;
const allJsonLd = breadcrumb ? [...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []), breadcrumb] : jsonLd;
---

<!doctype html>
<html lang={lang} dir={isUrdu ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0b1220" />
    <meta name="generator" content={Astro.generator} />

    <!-- Font: preconnect to Google Fonts origins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Load Inter (body) + Space Grotesk (display) — reduced to 3 weights -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Space+Grotesk:wght@400;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Space+Grotesk:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Space+Grotesk:wght@400;600;700&display=swap"
      />
    </noscript>

    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      robots={robots}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={allJsonLd}
      locale={lang}
      alternates={alternates}
    />
    {isUrdu && <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;600;700&display=swap" />}
    <!-- Per-page head additions (preloads, etc.) -->
    <slot name="head" />
  </head>
  <body>
    <!-- Skip navigation for keyboard users -->
    <a href="#main-content" class="skip-nav">Skip to main content</a>
    <slot />
    <LegalInfoDialog client:idle />
  </body>
</html>
