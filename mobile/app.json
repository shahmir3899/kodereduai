{
  "expo": {
    "name": "Education AI",
    "slug": "kodereduai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "educationai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e40af"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.educationai.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Education AI uses the camera to take attendance and student photos.",
        "NSLocationWhenInUseUsageDescription": "This app uses your location to share your journey status with parents.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Education AI shares the school bus location with parents during a journey, including when the app is closed."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e40af"
      },
      "package": "pk.educationai.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://www.educationai.pk"
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Education AI to use the camera to take attendance and student photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Education AI to use your location for journey tracking.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1e40af"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Education AI to access your photos."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://personal-gateway-sg.onrender.com/educationai",
      "appEnv": "production",
      "allowInsecureHttp": false,
      "router": {
        "origin": "https://www.educationai.pk"
      },
      "eas": {
        "projectId": "b157c887-f004-4827-9a18-179bd88a06d5"
      }
    }
  }
}
