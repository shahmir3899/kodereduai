# =============================================================================
# KoderEduAI.pk - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# =============================================================================

# ---------------------------------------------------------------------------
# Environment Toggle
# ---------------------------------------------------------------------------
# Set to "production" on your deployed server, "local" for development.
# This single variable controls: DEBUG, security headers, logging levels, JWT lifetimes.
ENVIRONMENT=local

# ---------------------------------------------------------------------------
# Django Core
# ---------------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# PostgreSQL connection URL. Leave empty to use SQLite (local dev only).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated allowed frontend origins. Local: http dev servers. Production: every HTTPS SPA
# hostname that calls this API must be listed (e.g. https://focus.kodereduai.pk) or match the regexes
# in config/settings.py. Render: set alongside VITE_API_URL on the frontend service.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Celery / Redis
# ---------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# No-Celery / Manual-click mode
# ---------------------------------------------------------------------------
# Set CELERY_FORCE_SYNC=true to bypass the Celery worker entirely.
# All background tasks (fee generation, payslips, reports, timetable, bulk
# promotion, face attendance, embeddings) will run synchronously inside the
# web request.  No Redis connection is required for task dispatch.
#
# WHEN TO USE:
#   - You do not run a Celery worker on Render (or anywhere)
#   - You want manual-click execution instead of automatic background jobs
#   - Upstash free tier limits are being hit by an idle queue
#
# TRADE-OFFS:
#   - Large tasks (>50 students / >50 staff) will block the HTTP response
#     for a few extra seconds.  Render's 90s timeout is still respected.
#   - Scheduled Beat jobs (absence digests, fee reminders) will NOT fire
#     automatically.  Run them manually:
#       python manage.py run_scheduled_jobs --all
#       python manage.py run_cleanup_jobs --all
#
# LOCAL DEV DEFAULT (already set in settings.py via CELERY_TASK_ALWAYS_EAGER):
#   CELERY_FORCE_SYNC is not required locally.
#
# PRODUCTION (set this in Render env vars, not here):
#   CELERY_FORCE_SYNC=true   ← add this
#   ENABLE_CELERY=false      ← stop worker starting in start.sh
#   ENABLE_CELERY_BEAT=false ← stop Beat starting in start.sh
CELERY_FORCE_SYNC=false

# ---------------------------------------------------------------------------
# DB-backed async queue (Celery replacement path)
# ---------------------------------------------------------------------------
# Set true to enqueue user-triggered background jobs into PostgreSQL (core_queuedjob)
# and run them via: python manage.py run_job_worker
#
# Recommended migration path:
#   DB_JOB_QUEUE_ENABLED=true
#   ENABLE_CELERY=false
#   ENABLE_CELERY_BEAT=false
#   CELERY_FORCE_SYNC=false
DB_JOB_QUEUE_ENABLED=false

# ---------------------------------------------------------------------------
# Groq LLM API
# ---------------------------------------------------------------------------
# Get your key from: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ---------------------------------------------------------------------------
# Vision Pipeline
# ---------------------------------------------------------------------------
USE_VISION_PIPELINE=True
# Provider: 'google' (recommended for handwriting) or 'groq'
VISION_PROVIDER=google

# ---------------------------------------------------------------------------
# Google Cloud Vision API
# ---------------------------------------------------------------------------
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=your_google_vision_api_key_here
# Alternative: Path to service account JSON (more secure)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ---------------------------------------------------------------------------
# Tesseract OCR (legacy fallback)
# ---------------------------------------------------------------------------
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux:   /usr/bin/tesseract
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------------------------------------------------------------------------
# Supabase (File Storage)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_BUCKET=attendance-uploads

# ---------------------------------------------------------------------------
# WhatsApp API (optional)
# ---------------------------------------------------------------------------
# WHATSAPP_PROVIDER=http  -> POST WHATSAPP_API_URL with Bearer + JSON {sender_id, phone, message}
# WHATSAPP_PROVIDER=waha -> POST {WHATSAPP_API_URL}/api/sendText with X-Api-Key + JSON {session, chatId, text}
# For WAHA: base URL only (e.g. http://127.0.0.1:3080 — see infra/waha/docker-compose.yml). School.whatsapp_sender_id = WAHA session name.
WHATSAPP_PROVIDER=http
WHATSAPP_API_URL=
WHATSAPP_API_KEY=

# ---------------------------------------------------------------------------
# Email / SMTP (required for careers email with CV attachment)
# ---------------------------------------------------------------------------
# Local development can keep console backend to print emails in terminal.
# Production should use SMTP backend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=noreply@koderkids.pk

# ---------------------------------------------------------------------------
# Careers submission delivery
# ---------------------------------------------------------------------------
# Where careers applications (with CV attachment) are emailed.
CAREERS_EMAIL_RECIPIENT=admin@koderkids.pk
# Sender for careers notification emails.
CAREERS_EMAIL_SENDER=noreply@koderkids.pk
# Also save applications in DB in addition to email (recommended True).
CAREERS_SAVE_TO_DB=True
# Where public landing demo/contact form notifications are emailed.
LANDING_FORMS_EMAIL_RECIPIENT=admin@koderkids.pk
# Sender for landing demo/contact/careers notification emails.
LANDING_FORMS_EMAIL_SENDER=noreply@koderkids.pk
